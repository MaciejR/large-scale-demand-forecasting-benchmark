\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Forest plot of cross-paper pooled $\Delta $ cells on M5 (3~\textsc  {wape}{} cells + 1~\textsc  {wrmsse}{} cell). Each row is a (horizon, metric) bucket; the horizontal axis is $\Delta = \text  {mean(FM)} - \text  {mean(ML\_TREE)}$ with negative = FM better. The three \textsc  {wape}{} cells show large negative $\Delta $ ($-0.54$ to $-0.78$), reflecting the per-series \textsc  {wape}{} artefact on intermittent demand (\S  5.4.5). The single \textsc  {wrmsse}{} cell reverses sign ($\Delta = +0.41$, FM worse). This within-dataset metric reversal is the central evidence that the M5 FM advantage is metric-specific, not family-level.}}{38}{figure.1}\protected@file@percent }
\newlabel{fig:forest_m5}{{1}{38}{Forest plot of cross-paper pooled $\Delta $ cells on M5 (3~\WAPE {} cells + 1~\WRMSSE {} cell). Each row is a (horizon, metric) bucket; the horizontal axis is $\Delta = \text {mean(FM)} - \text {mean(ML\_TREE)}$ with negative = FM better. The three \WAPE {} cells show large negative $\Delta $ ($-0.54$ to $-0.78$), reflecting the per-series \WAPE {} artefact on intermittent demand (\S 5.4.5). The single \WRMSSE {} cell reverses sign ($\Delta = +0.41$, FM worse). This within-dataset metric reversal is the central evidence that the M5 FM advantage is metric-specific, not family-level}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Forest plot of cross-paper pooled $\Delta $ cells on Favorita (3~\textsc  {wape}{} cells across horizons 7, 14, 28). All three cells show small negative $\Delta $ ($-0.012$ to $-0.021$), consistent with the headline finding that the FM-vs-\textsc  {lgbm}{} gap is indistinguishable from zero on smooth-demand retail data. The narrow range across horizons indicates that neither family degrades faster with horizon length on this dataset.}}{39}{figure.2}\protected@file@percent }
\newlabel{fig:forest_favorita}{{2}{39}{Forest plot of cross-paper pooled $\Delta $ cells on Favorita (3~\WAPE {} cells across horizons 7, 14, 28). All three cells show small negative $\Delta $ ($-0.012$ to $-0.021$), consistent with the headline finding that the FM-vs-\LGBM {} gap is indistinguishable from zero on smooth-demand retail data. The narrow range across horizons indicates that neither family degrades faster with horizon length on this dataset}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Forest plot of cross-paper pooled $\Delta $ cells on Rohlik (3~\textsc  {wape}{} cells across horizons 7, 14, 28). $\Delta $ ranges from $-0.055$ (short) to $-0.089$ (long), showing a modest FM advantage that grows with horizon. This is the strongest per-dataset FM signal in the excl-M5 pool, but it does not reach significance in the pooled model (Table~\ref {tab:t61}, excl-M5 intercept $p = 0.174$).}}{40}{figure.3}\protected@file@percent }
\newlabel{fig:forest_rohlik}{{3}{40}{Forest plot of cross-paper pooled $\Delta $ cells on Rohlik (3~\WAPE {} cells across horizons 7, 14, 28). $\Delta $ ranges from $-0.055$ (short) to $-0.089$ (long), showing a modest FM advantage that grows with horizon. This is the strongest per-dataset FM signal in the excl-M5 pool, but it does not reach significance in the pooled model (Table~\ref {tab:t61}, excl-M5 intercept $p = 0.174$)}{figure.3}{}}
