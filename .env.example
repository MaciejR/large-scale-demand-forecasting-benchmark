# Optional Zenodo upload credentials.
# Copy to .env for local use; never commit real token values.
# tools/publish_v112_zenodo.sh and the token-readiness audit import only the
# known Zenodo token variables below from .env. Direct Python uploader calls
# require exported variables.

# Production Zenodo API token for https://zenodo.org
ZENODO_ACCESS_TOKEN=

# Alternative production token variable accepted by the upload scripts.
ZENODO_TOKEN=

# Sandbox Zenodo API token for https://sandbox.zenodo.org
ZENODO_SANDBOX_ACCESS_TOKEN=

# Alternative sandbox token variable accepted by the upload scripts.
ZENODO_SANDBOX_TOKEN=
